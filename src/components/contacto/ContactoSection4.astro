<section class="contact-section" aria-labelledby="contact-title">
    <div class="container contact-grid">
      <div class="contact-form-card">
        <h2 id="contact-title" class="section-title">Escríbenos</h2>
        <p class="section-subtitle">Te responderemos en el menor tiempo posible.</p>

        <form id="contact-form" novalidate>
          <div class="form-row">
            <label for="name">Nombre</label>
            <input id="name" name="name" type="text" placeholder="Tu nombre completo" autocomplete="name" required aria-describedby="err-name">
            <span id="err-name" class="field-error" role="alert" aria-live="polite"></span>
          </div>

          <div class="form-row">
            <label for="email">Correo</label>
            <input id="email" name="email" type="email" placeholder="tucorreo@ejemplo.com" autocomplete="email" required aria-describedby="err-email">
            <span id="err-email" class="field-error" role="alert" aria-live="polite"></span>
          </div>

          <div class="form-row">
            <label for="subject">Asunto</label>
            <input id="subject" name="subject" type="text" placeholder="¿Sobre qué te ayudamos?" required aria-describedby="err-subject" maxlength="120">
            <span id="err-subject" class="field-error" role="alert" aria-live="polite"></span>
          </div>

          <div class="form-row">
            <label for="message">Mensaje</label>
            <textarea id="message" name="message" rows="5" placeholder="Cuéntanos brevemente tu necesidad" required aria-describedby="err-message" maxlength="1000"></textarea>
            <span id="err-message" class="field-error" role="alert" aria-live="polite"></span>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn btn-primary btn-l">Enviar mensaje</button>
            <a class="btn btn-secondary btn-l" href="https://wa.me/573106979630?text=Hola,%20necesito%20asesor%C3%ADa" target="_blank" rel="noopener noreferrer">WhatsApp</a>
          </div>

          <div id="form-status" class="form-status" role="status" aria-live="polite" hidden></div>
        </form>
      </div>

      <aside class="contact-aside">
        <div class="c-card">
          <div class="c-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          </div>
          <div class="c-text"><strong>Correo</strong><span>soporte@herbeplast.com</span></div>
        </div>
        <div class="c-card">
          <div class="c-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
          </div>
          <div class="c-text"><strong>Teléfono</strong><span>+57 3106979630 - +57 318 3640557</span></div>
        </div>
        <div class="c-card">
          <div class="c-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <div class="c-text"><strong>Ubicación</strong><span>Bogotá, Colombia</span></div>
        </div>
