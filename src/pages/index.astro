---
import CertificationsSection from '../components/home/CertificationsSection.astro';
import HeroSection from '../components/home/HeroSection.astro';
import HomeCtaSection from '../components/home/HomeCtaSection.astro';
import IndustryCarousel from '../components/home/IndustryCarousel.astro';
import ProductionVideo from '../components/home/ProductionVideo.astro';
import ValueSection from '../components/home/ValueSection.astro';
import SiteLayout from '../layouts/SiteLayout.astro';

const pageTitle = 'Herbeplast | Empaques Flexibles PE y PP - Calidad Certificada desde 1995';
const pageDescription = 'Herbeplast produce empaques flexibles en PE y PP desde 1995. Calidad certificada, tecnología de vanguardia y servicio personalizado para industria y comercio.';
---

<SiteLayout title={pageTitle} description={pageDescription}>
	<main id="main">
		<HeroSection />
		<ProductionVideo />
		<IndustryCarousel />
		<ValueSection />
		<CertificationsSection />
		<HomeCtaSection />
	</main>

	<script src="../scripts/home.js"></script>
</SiteLayout>
